generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(uuid())
  email    String @unique
  password String
  name     String?
}

model Product {
  id        String   @id @default(uuid())
  title     String
  price     Int
  image     String
  userId    String
  createdAt DateTime @default(now())
}

model Order {
  id        String   @id @default(uuid())
  productId String
  buyerId   String
  status    String   @default("confirmée")
  createdAt DateTime @default(now())
}
