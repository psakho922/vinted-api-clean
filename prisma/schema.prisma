generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(uuid())
  email    String @unique
  password String
  name     String?
}

model Product {
  id        String   @id @default(uuid())
  title     String
  price     Int
  image     String
  userId    String
  createdAt DateTime @default(now())
}

model Message {
  id        String   @id @default(uuid())
  text      String
  senderId  String
  receiverId String
  productId String
  createdAt DateTime @default(now())
}

model Order {
id           String   @id @default(uuid())
  productId    String
  price        Int
  commission   Float
  sellerAmount Float
  createdAt    DateTime @default(now())
}
